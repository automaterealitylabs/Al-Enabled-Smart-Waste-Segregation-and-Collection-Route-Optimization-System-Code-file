# Flask Environment Configuration
FLASK_APP=backend.app
FLASK_ENV=development
FLASK_DEBUG=True

# ─────────────────────────────────────────────────────────
# REQUIRED: Security
# ─────────────────────────────────────────────────────────
# MANDATORY in production on Render.
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-strong-secret-key

# ─────────────────────────────────────────────────────────
# REQUIRED: Supabase Database
# ─────────────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ─────────────────────────────────────────────────────────
# REQUIRED: Cloudinary Persistent Image Storage
# ─────────────────────────────────────────────────────────
# Required in production. Render's local filesystem is ephemeral.
# Get these from https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────────────────
# OPTIONAL: Port (set automatically by Render)
# ─────────────────────────────────────────────────────────
PORT=5000

# ─────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────
# Maps: The application uses Leaflet.js + OpenStreetMap (no API key required).
# ML/Route Optimizer: Pure Python implementation, no external API keys required.
